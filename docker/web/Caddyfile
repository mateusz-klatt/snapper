{
	admin off
}

:8000 {
	encode gzip zstd

	handle /api/* {
		reverse_proxy snapper:8000
	}
	handle /docs* {
		reverse_proxy snapper:8000
	}
	handle /redoc* {
		reverse_proxy snapper:8000
	}
	handle /openapi.json {
		reverse_proxy snapper:8000
	}

	handle /assets/* {
		root * /srv/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/dist
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}

	log {
		output stdout
		format console
	}
}
