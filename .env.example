# Database connection
DB_URL=sqlite+aiosqlite:///./data/snapper.db

# Encryption settings for sensitive data (API keys, secrets)
# IMPORTANT: Change this default in production!
MASTER_PASSWORD=snapper_default_master_password_v1
#
# To rotate encryption keys in production:
# 1. Run: snapper settings-rotate-encryption --new-password "your-new-password"
# 2. Update MASTER_PASSWORD with the new value
# 3. Restart the application

# Server settings - needed to start the web server before database is available
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=false
SERVER_API_ONLY=false
SERVER_PROXY_HEADERS=true
SERVER_FORWARDED_ALLOW_IPS=127.0.0.1,172.17.0.1

# Telemetry recording - record pings, heartbeats, GET reads to telemetry table
# High volume; enable for debugging only
TELEMETRY_RECORDING_ENABLED=false

# ZMQ broker settings - needed for settings service event broadcasting
ZMQ_BROKER_XSUB=tcp://127.0.0.1:7500
ZMQ_BROKER_XPUB=tcp://127.0.0.1:7501

# Trade runtime partitioning (Phase 4) — per-coordinator identity.
# Default N=1 (single coordinator owns every shard) is byte-identical
# to pre-Phase-4 behavior. To scale to N>=2, bring up one process per
# instance with distinct SNAPPER_COORDINATOR_INSTANCE_ID (0-indexed)
# and a shared SNAPPER_COORDINATOR_INSTANCE_COUNT. See
# docs/operations.md for the systemd template recipe.
SNAPPER_COORDINATOR_INSTANCE_ID=0
SNAPPER_COORDINATOR_INSTANCE_COUNT=1
# Outbox scan cap — rows inspected per 50ms poll while filtering for
# owned shards. Default 1000 handles typical deployments; set to
# "unbounded" / "" / "none" to disable the cap.
SNAPPER_COORDINATOR_OUTBOX_MAX_SCAN_ROWS=1000

# System-metrics snapshotter (Cluster A observability)
# Sample interval seconds for the in-memory metrics ring buffer.
SYSTEM_METRICS_INTERVAL_SECONDS=5
# Ring buffer cap (snapshot count). Default 17280 ≈ 24h at 5s.
SYSTEM_METRICS_HISTORY_CAP=17280
