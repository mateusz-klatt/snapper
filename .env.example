# Database connection
DB_URL=sqlite+aiosqlite:///./data/snapper.db

# Deployment environment. Keep development for local/test setups.
# Production-like modes (production, prod, staging) refuse placeholder
# MASTER_PASSWORD, auth_secret_key, and csrf_secret_key values.
SNAPPER_ENV=development

# Encryption settings for sensitive data (API keys, secrets)
# IMPORTANT: Change this default in production!
MASTER_PASSWORD=snapper_default_master_password_v1
#
# To rotate encryption keys in production:
# 1. Run: snapper settings-rotate-encryption
#    (prompts for the new master password with hidden input + confirmation;
#    omit --new-password so the value does NOT land in shell history)
#    This rotates encrypted settings rows only.
# 2. Rotate or recreate wallet credentials separately; they use the same
#    master-password Fernet key and are not rewritten by the settings command.
# 3. Update MASTER_PASSWORD in this file with the value you just entered
# 4. Restart the application

# Server settings - needed to start the web server before database is available
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=false
SERVER_API_ONLY=false
# Autostart profile: which registered processes this node starts.
#   all  = everything (default, single-container / dev)
#   api  = everything EXCEPT market-data publishers (backend container —
#          publishers move to the feed container so the API loop stops
#          sharing CPU with them under NYSE burst)
#   feed = ONLY market-data publishers (dedicated feed container; set by
#          the publishers-only feed CLI entrypoint)
PROCESS_AUTOSTART_PROFILE=all
SERVER_PROXY_HEADERS=true
SERVER_FORWARDED_ALLOW_IPS=127.0.0.1,172.17.0.1

# Telemetry recording - record pings, heartbeats, GET reads to telemetry table
# High volume; enable for debugging only
TELEMETRY_RECORDING_ENABLED=false

# ZMQ broker settings - needed for settings service event broadcasting
# XSUB/XPUB are the CONNECT endpoints (publishers/subscribers connect here).
ZMQ_BROKER_XSUB=tcp://127.0.0.1:7500
ZMQ_BROKER_XPUB=tcp://127.0.0.1:7501
# Broker BIND endpoints. Empty (default) binds the connect endpoint above —
# correct for single-container / embedded-broker runs. In the compose
# split a dedicated snapper-broker container binds tcp://0.0.0.0:7500/7501
# via explicit CLI flags and EVERY service (backend, feed, egress)
# connects to tcp://snapper-broker:7500/7501. See docker-compose.yml.
# ZMQ_BROKER_BIND_XSUB=tcp://0.0.0.0:7500
# ZMQ_BROKER_BIND_XPUB=tcp://0.0.0.0:7501
# Set false when a dedicated snapper-broker container owns the bus (the
# compose file does this for the backend); default true keeps the
# embedded broker for single-container and dev runs.
# ZMQ_BROKER_EMBEDDED=true

# Per-process SQLAlchemy pool clamp (PostgreSQL only). Unset = SQLAlchemy
# defaults (pool_size 5 + max_overflow 10). Set on the feed container so N
# publisher subprocesses do not multiply the pool toward Postgres
# max_connections. Keep count(publishers) * (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# + backend pool comfortably under the server's max_connections.
# DB_POOL_SIZE=2
# DB_MAX_OVERFLOW=3

# Trade runtime partitioning — per-coordinator identity.
# Default N=1 (single coordinator owns every shard) is byte-identical
# to single-instance behavior. To scale to N>=2, bring up one process per
# instance with distinct SNAPPER_COORDINATOR_INSTANCE_ID (0-indexed)
# and a shared SNAPPER_COORDINATOR_INSTANCE_COUNT. N>=2 requires
# PostgreSQL — the coordinator fails fast at startup on SQLite, where
# SELECT ... FOR UPDATE row locking is a no-op. See
# docs/operations.md for the systemd template recipe.
SNAPPER_COORDINATOR_INSTANCE_ID=0
SNAPPER_COORDINATOR_INSTANCE_COUNT=1
# Outbox scan cap — rows inspected per 50ms poll while filtering for
# owned shards. Default 1000 handles typical deployments; set to
# "unbounded" / "" / "none" to disable the cap.
SNAPPER_COORDINATOR_OUTBOX_MAX_SCAN_ROWS=1000
# Dispatch max-age TTL (seconds) for trade commands: stale CREATED
# create/submit commands expire at the outbox (terminal EXPIRED, never
# published; cancels/replaces are exempt); the executor venue-verifies
# stale frames before any order placement (a found order is adopted, an
# unverifiable venue drops the frame silently, only venue-verified
# absence rejects), so an outage backlog cannot fire MARKET orders
# priced off old signals.
# Must stay below the engine's 60s in-flight valve; <= 0 disables.
TRADE_COMMAND_DISPATCH_TTL_S=30.0

# Paired-execution guard — multi-leg (spread/basket) order safety.
# The guard ships DARK: with PAIRED_EXECUTION_GUARD_ENABLED=false
# (default) BaseStrategy refuses to emit a multi-leg group on a live
# exchange (fail-closed); paper multi-leg is always allowed. Timeouts
# bound group assembly and fill confirmation before the guard breaks
# the group and compensates. See docs/paired-execution.md.
# PAIRED_EXECUTION_GUARD_ENABLED=false
# PAIRED_EXECUTION_ASSEMBLY_TIMEOUT_S=5.0
# PAIRED_EXECUTION_FILL_TIMEOUT_S=30.0

# System-metrics snapshotter (Cluster A observability)
# Sample interval seconds for the in-memory metrics ring buffer.
SYSTEM_METRICS_INTERVAL_SECONDS=5
# Ring buffer cap (snapshot count). Default 17280 ≈ 24h at 5s.
SYSTEM_METRICS_HISTORY_CAP=17280
# Free-byte WARNING threshold for the data partition sampled by system metrics.
SYSTEM_METRICS_DISK_FREE_WARN_BYTES=21474836480
# Free-byte CRITICAL threshold for the data partition sampled by system metrics.
SYSTEM_METRICS_DISK_FREE_CRIT_BYTES=10737418240
# Mount path containing Postgres data; default is host root.
SYSTEM_METRICS_DISK_MOUNT_PATH=/

# Market-data watchdog (silent-exchange alerting)
# Park the watchdog entirely when truthy (1/true/yes). No eager tick, no loop.
MARKET_DATA_WATCHDOG_DISABLED=false
# Poll cadence seconds for the per-exchange candle-freshness check. Floor 5.
MARKET_DATA_WATCHDOG_INTERVAL_SECONDS=60
# Default whole-exchange silence threshold in seconds before the synthetic
# WARNING heartbeat burst fires the critical_system_error alert. Floor 120
# (candle write lag alone runs up to ~90s on a healthy pipeline).
MARKET_DATA_WATCHDOG_THRESHOLD_SECONDS=600
# Optional per-exchange overrides as exchange=seconds CSV; 0 disables one
# exchange. Example: walutomat=1200,kraken_equities=900
# MARKET_DATA_WATCHDOG_EXCHANGE_THRESHOLDS=

# Retention policy framework (Cluster C observability)
# Scheduler loop period in seconds. Empty / non-positive falls back to default 3600.
RETENTION_INTERVAL_SECONDS=3600
# Park the scheduler entirely when truthy (1/true/yes). No eager run, no loop.
RETENTION_DISABLED=false
# Force purge=False on every archiver call when truthy. Operators flip to true
# for one cycle when adding a NEW high-volume policy to verify the window.
RETENTION_DRY_RUN=false
# Filesystem root for the CSV archive layout. Matches the snapper archive CLI default.
RETENTION_OUTPUT_DIR=data

# DB stats sampler (Cluster B observability)
# Sample interval seconds for GET /api/metrics/db/tables. Empty / non-positive
# falls back to default 60.
DB_METRICS_INTERVAL_SECONDS=60
# Park the snapshotter entirely when truthy (1/true/yes). The metrics route
# returns 503 with a disabled-mode detail; PG operators without psycopg2 in
# deps boot cleanly with this flag.
DB_METRICS_DISABLED=false

# Publisher hot-path probes (opt-in diagnostics, disabled by default). Set to 1
# to emit per-tick / per-trade timing samples when investigating feed latency.
# SNAPPER_TICK_PROBE=1
# SNAPPER_TRADE_PROBE=1
