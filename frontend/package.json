{
  "name": "snapper-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache . --fix",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dead-code": "knip",
    "dead-code:fix": "knip --fix",
    "test": "vitest",
    "test:run": "vitest run --no-file-parallelism",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "gen:api-types": "openapi-typescript ../build/openapi.json -o src/types/api.generated.ts --export-type",
    "gen:api-types:live": "openapi-typescript http://localhost:8000/openapi.json -o src/types/api.generated.ts",
    "gen:ws-types": "json2ts ../build/ws-schemas.json -o src/types/ws.generated.ts --additionalProperties false",
    "gen:zod": "echo 'Use make ui-gen-zod - requires Python script'"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@tanstack/react-query": "^5.99.0",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hot-toast": "^2.6.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "pnpm": {
    "overrides": {
      "lodash-es": ">=4.17.23",
      "jsdom": "26.1.0"
    },
    "onlyBuiltDependencies": [
      "puppeteer"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-istanbul": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "26.1.0",
    "json-schema-to-typescript": "15.0.4",
    "json-schema-to-zod": "^2.8.1",
    "knip": "^6.4.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.9",
    "prettier": "^3.8.2",
    "puppeteer": "^24.40.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
